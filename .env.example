# AgroMarket Environment Variables Configuration
# Copy this file to .env.local for local development.
# NEVER commit real secret keys or .env.local to version control!

# ------------------------------------------------------------------------------
# Supabase Configuration (V1 Database, Auth, Storage)
# ------------------------------------------------------------------------------
# Publicly accessible Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Anon Key (safe for browser use with Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Only Service Role Key (NEVER expose to the browser; bypasses RLS for trusted admin tasks)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
# Base URL for application routing, redirects, and webhooks
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment mode (development | test | production)
NODE_ENV=development

# ------------------------------------------------------------------------------
# Payment Gateways (Nigerian Fiat First)
# ------------------------------------------------------------------------------
# Paystack API Keys (test keys start with sk_test_ / pk_test_)
PAYSTACK_SECRET_KEY=sk_test_placeholder_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_placeholder_public_key
PAYSTACK_WEBHOOK_SECRET=placeholder_paystack_webhook_secret

# Flutterwave API Keys (test keys start with FLWSECK_TEST-)
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST_placeholder_secret_key
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST_placeholder_public_key
FLUTTERWAVE_WEBHOOK_SECRET=placeholder_flutterwave_secret_hash

# ------------------------------------------------------------------------------
# Phase 2.2: AI & Agent Reasoning Foundation
# ------------------------------------------------------------------------------
# Supported providers: OPENAI | GEMINI (Leave empty to use Unavailable provider)
AI_PROVIDER=OPENAI
AI_MODEL=gpt-4o-mini
# Secret Server-Only API key (NEVER expose to browser or prefix with NEXT_PUBLIC_)
AI_API_KEY=your-ai-provider-api-key-here

