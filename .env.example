# ==============================================================================
# AgroMarket Production & Local Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit real production keys or sensitive secrets to version control!
# In production (e.g. Vercel, Railway, Supabase), configure these via your
# hosting provider's secure Environment Variables dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Infrastructure (REQUIRED FOR CORE APPLICATION)
# ------------------------------------------------------------------------------
# Publicly accessible Supabase Project REST URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Anon/Publishable Key (Safe for client browsers with RLS enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Server-Only Service Role Key (NEVER expose to browser; strictly required in production for admin actions & background workers)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Application & Hosting (REQUIRED)
# ------------------------------------------------------------------------------
# Canonical base URL for redirects, email links, and webhook callbacks
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Runtime environment (development | test | production)
NODE_ENV=development

# ------------------------------------------------------------------------------
# 3. Background Job Processing & Scheduler (REQUIRED FOR ASYNC JOBS)
# ------------------------------------------------------------------------------
# Secret token authenticating scheduled cron invocations (e.g. /api/cron/process-jobs)
# Set this in Vercel project settings matching your CRON_SECRET header
CRON_SECRET=your-secure-random-cron-secret-token-here

# Optional secondary alias for external scheduling triggers
SCHEDULER_SECRET=your-secure-random-scheduler-secret-here

# ------------------------------------------------------------------------------
# 4. Payment Gateways (OPTIONAL FOR BROWSE / REQUIRED FOR CHECKOUT)
# ------------------------------------------------------------------------------
# Paystack API Keys & Webhook Secret (Test keys start with sk_test_ / pk_test_)
PAYSTACK_SECRET_KEY=sk_test_placeholder_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_placeholder_public_key
PAYSTACK_WEBHOOK_SECRET=placeholder_paystack_webhook_secret

# Flutterwave API Keys & Secret Hash (Test keys start with FLWSECK_TEST-)
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST_placeholder_secret_key
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST_placeholder_public_key
FLUTTERWAVE_WEBHOOK_SECRET=placeholder_flutterwave_secret_hash

# ------------------------------------------------------------------------------
# 5. Agricultural Intelligence & AI (OPTIONAL - DETERMINISTIC FALLBACKS ACTIVE)
# ------------------------------------------------------------------------------
# Google Gemini API Key for agronomic assistant and scenario reasoning
# Leave blank to use safe, deterministic algorithmic analysis
GEMINI_API_KEY=your-gemini-api-key-here
